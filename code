<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <title>TWGHs Mrs. Fung Wong Fung Ting College Timetable</title>
    <style>
        /* 基礎設定 */
        body { font-family: "Times New Roman", Times, serif; padding: 20px; background-color: #fff; color: #000; margin: 0; }
        
        /* 控制面板 (網頁顯示專用) */
        .controls { background: #f4f4f9; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-family: "Arial", sans-serif; }
        .controls label { margin-right: 15px; font-weight: bold; display: inline-block; margin-bottom: 5px; font-size: 13px; }
        select { padding: 2px; }
        .btn-group { margin-top: 15px; display: flex; gap: 10px; }
        button { padding: 8px 15px; cursor: pointer; border: none; border-radius: 4px; font-weight: bold; color: white; }
        .btn-generate { background-color: #007bff; }
        .btn-generate:hover { background-color: #0056b3; }
        .btn-print { background-color: #28a745; }
        .btn-print:hover { background-color: #218838; }

        /* 防止網頁版因為嚴格比例而變形嘅橫向捲軸 */
        .table-scroll-wrapper { width: 100%; overflow-x: auto; margin-bottom: 20px; }
        
        /* 標題區塊 */
        .header-container { margin-bottom: 5px; min-width: 1225px; } 
        .school-name { text-align: center; font-weight: bold; font-size: 16px; margin-bottom: 3px; }
        .sub-header-row { display: flex; justify-content: space-between; align-items: center; font-weight: bold; font-size: 14px; }
        .sub-header-row .class-name, .sub-header-row .room-name { width: 50px; }
        .sub-header-row .academic-year { flex-grow: 1; text-align: center; }
        .sub-header-row .room-name { text-align: right; }

        /* 核心表格樣式 */
        table { border-collapse: collapse; table-layout: fixed; width: max-content; }
        th, td { border: 1px solid #000; text-align: center; vertical-align: middle; padding: 0; overflow: hidden; }
        
        /* =========================================
           【網頁預覽版】黃金比例 225:40 絕對鎖定
           ========================================= */
        th.time-col, th.day-col { font-weight: bold; }
        
        .time-col { width: 100px; height: 40px; font-size: 13px; line-height: 1.1; }
        .day-col { width: 225px; height: 40px; font-size: 14px; }
        .class-row td, .merged-row, .tfoot-row td { height: 40px; }

        /* ！！！根據要求：主時間粗體，括號時間普通字體！！！ */
        .time-main { font-weight: bold; font-size: 13px; display: block; line-height: 1; }
        .time-sub { font-weight: normal; font-size: 11px; display: block; line-height: 1; }
        
        /* 小息 Lunch 保持普通字體 */
        .merged-row { font-size: 13px; font-weight: normal; }
        
        /* ！！！根據要求：底部 Footer 變回粗體！！！ */
        .tfoot-row td { font-weight: bold; font-size: 13px; text-align: left; padding-left: 5px; }

        /* 儲存格內排版 (科目與老師保持普通字體) */
        .cell-container { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; height: 100%; width: 100%; padding: 2px 4px; box-sizing: border-box; font-size: 12px; font-weight: normal; }
        .subject { grid-column: 1 / 2; text-align: left; }
        .room { grid-column: 2 / 3; text-align: right; }
        .teacher { grid-column: 1 / 3; text-align: right; align-self: end; }
        .cell-single { text-align: left; padding: 2px 4px; box-sizing: border-box; font-size: 12px; line-height: 1.1; display: flex; align-items: flex-start; font-weight: normal; }

        /* 螢幕顯示時隱藏第二份 */
        @media screen {
            #instance-2 { display: none; }
        }

        /* =========================================
           【A4 列印版】精準毫米轉換保持 225:40
           (33.75mm / 6mm = 5.625 = 225/40)
           ========================================= */
        @media print {
            @page { 
                size: A4 portrait;
                margin: 10mm;
            }
            body { padding: 0; margin: 0; -webkit-print-color-adjust: exact; }
            .controls { display: none !important; }
            
            .table-scroll-wrapper { overflow-x: visible !important; margin-bottom: 0 !important; }
            .header-container { min-width: auto !important; }

            /* 取消強制分頁，確保兩份完美塞入一頁 */
            #instance-1, #instance-2 { page-break-inside: avoid; }
            
            #instance-2 { 
                display: block !important; 
                border-top: 1px dashed #999; 
                padding-top: 6mm; 
                margin-top: 6mm;
            }

            .school-name { font-size: 14px; margin-bottom: 2px; }
            .sub-header-row { font-size: 12px; margin-bottom: 2px; }
            
            /* 鎖死列印高度與闊度 (絕對 225:40 比例) */
            .time-col { width: 15mm !important; height: 6mm !important; font-size: 10.5px !important; }
            .day-col { width: 33.75mm !important; height: 6mm !important; font-size: 11.5px !important; }
            .class-row td, .merged-row, .tfoot-row td { height: 6mm !important; }
            
            .merged-row { font-size: 12px !important; }
            .tfoot-row td { font-size: 11.5px !important; }
            
            .cell-container, .cell-single { font-size: 10px !important; padding: 0px 2px !important; line-height: 1.1 !important; }
            .time-main { font-size: 10.5px !important; }
            .time-sub { font-size: 8.5px !important; }
        }
    </style>
</head>
