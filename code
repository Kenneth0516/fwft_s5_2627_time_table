                "5X1": document.getElementById('sel-5x1').value,
                "5X2": document.getElementById('sel-5x2').value,
                "5X3": document.getElementById('sel-5x3').value,
                "Eng": document.getElementById('sel-eng').value,
                "Math": document.getElementById('sel-math').value,
                "Chi": document.getElementById('sel-chi').value,
                "PE": document.getElementById('sel-pe').value,
                "CSD": document.getElementById('sel-csd').value
            };
            
