            const tbody = document.getElementById('tb-body-' + tableNum);
            tbody.innerHTML = ''; 

            skeleton.forEach(row => {
                let tr = document.createElement('tr');
                if(row.type === 'class') tr.className = 'class-row';
                
                let tdTime = document.createElement('td');
                tdTime.className = 'time-col';
                tdTime.innerHTML = `<span class="time-main">${row.mainTime}</span>` + (row.subTime ? `<span class="time-sub">${row.subTime}</span>` : "");
                tr.appendChild(tdTime);

                if (row.type === 'fixed') {
                    let tdMerge = document.createElement('td');
                    tdMerge.colSpan = 5;
                    tdMerge.className = 'merged-row';
                    tdMerge.innerHTML = row.text;
                    tr.appendChild(tdMerge);
                } else {
                    ['mon', 'tue', 'wed', 'thu', 'fri'].forEach(day => {
                        let td = document.createElement('td');
                        td.className = 'day-col';
                        let blockName = row[day];

                        if (!blockName) {
                            td.innerHTML = ""; 
                        } else {
                            let info = null;
                            if (userChoices[blockName] && DB[blockName] && DB[blockName][userChoices[blockName]]) {
                                info = DB[blockName][userChoices[blockName]];
                            } else if (DB[blockName] && DB[blockName].sub) {
