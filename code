                            }

                            if (info) {
                                let roomStr = typeof info.room === 'object' ? (info.room[day] || "") : (info.room || "");
                                
                                if (!roomStr && !info.teacher) {
                                    td.innerHTML = `<div class="cell-single">${info.sub}</div>`;
                                } else {
                                    td.innerHTML = `<div class="cell-container"><div class="subject">${info.sub}</div><div class="room">${roomStr}</div><div class="teacher">${info.teacher}</div></div>`;
                                }
                            }
                        }
                        tr.appendChild(td);
                    });
                }
                tbody.appendChild(tr);
            });
        }

        function generateTimetable() {
            renderTable(1, 'student-name-1');
            renderTable(2, 'student-name-2');
        }

        function printPDF() {
            generateTimetable(); 
            window.print();
        }

        window.onload = generateTimetable;
    </script>
</body>
</html>